# Required: Your Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Required: YouTube livestream or VOD URL
YOUTUBE_URL=https://www.youtube.com/watch?v=YOUR_LIVESTREAM_ID

# Optional: Target translation language (default: en)
TARGET_LANGUAGE=en

# Optional: Gemini model name (default: gemini-3.5-live-translate-preview)
MODEL_NAME=gemini-3.5-live-translate-preview

# Optional: Audio chunk duration in seconds (default: 0.1 -> 100ms)
CHUNK_SECONDS=0.01